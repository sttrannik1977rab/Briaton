{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Sass",
      "type": "shell",
      "command": "sass --watch scss/style.scss css/style.css",
      "isBackground": true,
      "problemMatcher": "$sass-scss",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}